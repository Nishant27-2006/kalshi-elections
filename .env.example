# Copy this file to .env and fill in your own values. NEVER commit .env.
# Get your API key from https://kalshi.com/account/api  (Settings > API Keys)
# Kalshi gives you a Key ID + generates an RSA keypair; download the PRIVATE
# key as a .pem file and point KALSHI_PRIVATE_KEY_PATH at it.

KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi_private_key.pem

# "demo" for the paper-trading sandbox (recommended while testing),
# "prod" for real markets / real money.
KALSHI_ENV=demo
